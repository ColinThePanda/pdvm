label raylib_init
    @if OS_WINDOWS
    dlopen raylib examples/raylib_test/raylib/raylib.dll
    @elif OS_LINUX
    dlopen raylib examples/raylib_test/raylib/libraylib.so
    @elif OS_MACOS
    dlopen raylib examples/raylib_test/raylib/libraylib.dylib
    @else
    pushs Unsupported host OS for raylib_test
    error
    halt
    @endif

    # raylib.h
    dlsym raylib.InitWindow raylib InitWindow
